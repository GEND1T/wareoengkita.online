{
  "name": "waroengkita-backend",
  "version": "1.0.0",
  "description": "RESTful API Backend for WaroengKita Multi-Store E-Commerce",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "prisma generate && tsc",
    "postinstall": "prisma generate",
    "start": "node dist/server.js",
    "db:migrate": "prisma migrate dev --name init",
    "db:seed": "ts-node src/prisma/seed.ts",
    "prisma:generate": "prisma generate"
  },
  "keywords": [
    "express",
    "typescript",
    "prisma",
    "ecommerce"
  ],
  "author": "WaroengKita Dev Team",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.14.0",
    "@types/multer": "^2.2.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.12.12",
    "prisma": "^5.14.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
