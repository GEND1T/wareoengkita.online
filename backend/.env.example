PORT=5050
NODE_ENV=development

# Supabase PostgreSQL Connection String (Transaction Mode / Pooler)
DATABASE_URL="postgres://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-1-ap-northeast-2.pooler.supabase.com:5432/postgres?sslmode=require&connect_timeout=15"

# Supabase PostgreSQL Direct Connection String (Session / Direct Mode for Prisma Migrations)
DIRECT_URL="postgres://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-1-ap-northeast-2.pooler.supabase.com:5432/postgres?sslmode=require&connect_timeout=15"

JWT_SECRET="organikstore_super_secret_jwt_key_2026_9921823"
FRONTEND_URL="http://localhost:5173"

# WAHA (WhatsApp HTTP API) Integration Configuration
# Documentation: https://waha.devlike.pro/
# Set your WAHA container or server URL below (e.g. "http://localhost:3000" or "https://waha.yourdomain.com")
WAHA_URL="http://localhost:3000"
WAHA_API_KEY=""
WAHA_SESSION="default"

# Duitku Payment Gateway Configuration
# Docs: https://docs.duitku.com/api/id/
# Get credentials from: https://passport.duitku.com/merchant/Project
DUITKU_MERCHANT_CODE="DXXXX"
DUITKU_API_KEY="your_duitku_api_key_here"
DUITKU_SANDBOX="true"
DUITKU_CALLBACK_URL="https://your-domain.com/api/pembayaran/callback"
DUITKU_RETURN_URL="https://your-domain.com/pembayaran/status"
